# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/resilience-engine

# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API (Member 4: AI Nudge)
# Get your API key from: https://aistudio.google.com/apikey
# Leave empty to use rule-based fallback (demo-safe offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit .env to version control
