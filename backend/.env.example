# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/resilience-engine

# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini — paste your API key in backend/.env (https://aistudio.google.com/apikey)
# Never put the real key in this example file.
# Leave empty to always use the rule-based fallback (demo-safe offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Goals API (mounted at /api/goals and /goals)
# POST   /goals                 { user_id, name, target, icon? }
# GET    /goals/:userId
# POST   /goals/:goalId/contribute  { amount? }  default 500
# PATCH  /goals/:goalId
# DELETE /goals/:goalId

# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit .env to version control
